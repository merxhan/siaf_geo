    {
      "@type": "FAQPage",
      "@id": "https://centrogoianodavisao.com.br/#faq",
      "isPartOf": {
        "@id": "https://centrogoianodavisao.com.br/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como faço para agendar uma consulta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pelo WhatsApp ou pelo telefone (62) 93618-0791. A equipe informa os horários disponíveis e o profissional indicado para o seu caso."
          }
        },
        {
          "@type": "Question",
          "name": "Posso ir sem agendamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Atendemos sem horário marcado quando há médico disponível no momento. Para não esperar, recomendamos agendar antes."
          }
        },
        {
          "@type": "Question",
          "name": "A clínica aceita convênio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No momento o atendimento é particular. Os credenciamentos com convênios estão em andamento; consulte a equipe sobre a situação atual."
          }
        },
        {
          "@type": "Question",
          "name": "Vocês atendem crianças?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Consultas de rotina para crianças a partir de 7 anos."
          }
        },
        {
          "@type": "Question",
          "name": "E em caso de urgência?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Atendemos urgências oftalmológicas de segunda a sexta-feira, das 8h às 18h. Não há atendimento 24 horas. Fale com a equipe pelo WhatsApp ou telefone antes de vir."
          }
        },
        {
          "@type": "Question",
          "name": "Onde fica a clínica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rua 08, nº 646, 1º andar, Edifício Clínico Jacob Facuri, Setor Central, Goiânia–GO, CEP 74013-030."
          }
        },
        {
          "@type": "Question",
          "name": "Tem estacionamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A clínica fica na Rua 08, no Setor Central, região com boa oferta de estacionamentos nas proximidades. Se preferir, nossa equipe pode orientar sobre como chegar pelo WhatsApp."
          }
        }
      ]
    }
