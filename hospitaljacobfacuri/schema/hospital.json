      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como agendar consulta, exame ou solicitar informações sobre cirurgias no Hospital Jacob Facuri?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O agendamento é feito de segunda a sexta-feira, das 8h às 18h, pelo WhatsApp +55 (62) 99902-2623, pelos telefones (62) 3621-1919 e (62) 3621-1900 ou pelo e-mail consultas@jacobfacuri.com.br. Cobre consultas nas 24 especialidades do Centro Clínico, exames diagnósticos eletivos e informações sobre cirurgias."
          }
        },
        {
          "@type": "Question",
          "name": "O Hospital Jacob Facuri realiza endoscopia de urgência ou emergência?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. Endoscopia digestiva e colonoscopia são realizadas somente com agendamento prévio (exames eletivos) ou para pacientes já internados no hospital. Não há atendimento de endoscopia de urgência ou emergência 24 horas."
          }
        },
        {
          "@type": "Question",
          "name": "Quais serviços, cirurgias e atendimentos o hospital oferece?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pronto-socorro 24 horas, centro clínico com mais de 30 consultórios em 24 especialidades, centro cirúrgico com sete salas, UTI adulto (51 leitos) e neonatal (30 leitos), apartamentos e enfermarias, hemodinâmica 24 horas, diagnóstico por imagem, centro diagnóstico, Câncer Center em parceria com o Ingoh e oftalmologia com o Centro Goiano da Visão."
          }
        },
        {
          "@type": "Question",
          "name": "Quais convênios são atendidos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Particulares e 18 operadoras: Affego, Assefaz, Blue Saúde, Caesan Unimed, Cassi, Fundação Itaú, Fusex, Geap, Imas, Ipasgo, Mais Saúde, Porto Saúde, Postal Saúde, Saúde Caixa, Select, Unimed, Vitallis e Vivacom, mediante confirmação de cobertura do plano pela central de atendimento."
          }
        },
        {
          "@type": "Question",
          "name": "Onde fica o Hospital Jacob Facuri e qual o horário do pronto-socorro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fica na Rua 08, nº 657, Centro, Goiânia – GO, CEP 74013-030. O pronto-socorro funciona 24 horas por dia, todos os dias da semana."
          }
        },
        {
          "@type": "Question",
          "name": "Que tipo de urgência o pronto-socorro atende?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Urgências clínicas, ortopédicas, cardiológicas e cirúrgicas em adultos, com sala vermelha, sala de gesso e retaguarda de centro cirúrgico, UTIs, hemodinâmica 24 horas e diagnóstico por imagem. Não realiza endoscopia de urgência nem atendimento obstétrico."
          }
        },
        {
          "@type": "Question",
          "name": "O Hospital Jacob Facuri possui acreditação?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. O hospital possui acreditação ONA nível 3, Acreditado com Excelência, da Organização Nacional de Acreditação."
          }
        },
        {
          "@type": "Question",
          "name": "Quantos leitos de UTI o hospital possui?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "São 51 leitos de UTI adulto, incluindo 13 leitos de UTI humanizada, e 30 leitos de UTI neonatal."
          }
        },
        {
          "@type": "Question",
          "name": "Como falar com a ouvidoria do hospital?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pelo e-mail ouvidoria@jacobfacuri.com.br ou pelo telefone (62) 3621-1919, de segunda a sexta-feira, das 8h às 18h. Mais informações em https://jacobfacuri.com.br/ouvidoria/."
          }
        }
      ]
    }
