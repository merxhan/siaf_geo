      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quais especialidades o Hospital Jacob Facuri atende?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "São 24 especialidades médicas e odontológicas: Angiologia / Cirurgia Vascular; Buco-maxilo-facial; Cardiologia (cirúrgica, clínica e intervencionista); Cirurgia bariátrica; Cirurgia do aparelho digestivo; Cirurgia geral; Cirurgia plástica; Cirurgia torácica; Cirurgia vascular; Clínica médica; Coloproctologia / Cirurgia Geral; Gastroenterologia; Ginecologia e obstetrícia; Infectologia; Medicina de família; Neurologia (clínica e cirúrgica); Nutrologia e medicina funcional integrativa; Oncologia (clínica e cirúrgica); Ortopedia e Traumatologia; Otorrinolaringologia; Pediatria; Pneumologia; Radiologia e Urologia."
          }
        },
        {
          "@type": "Question",
          "name": "Qual especialidade tem mais médicos no Hospital Jacob Facuri?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As maiores são clínica médica (39), cirurgia plástica (18) e pediatria (11), em um corpo clínico de 134 profissionais."
          }
        },
        {
          "@type": "Question",
          "name": "Como agendar consulta com um especialista?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "De segunda a sexta-feira, das 8h às 18h, pelo WhatsApp +55 (62) 99902-2623, pelos telefones (62) 3621-1919 e (62) 3621-1900 ou pelo e-mail consultas@jacobfacuri.com.br."
          }
        },
        {
          "@type": "Question",
          "name": "O hospital tem atendimento odontológico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, na especialidade de cirurgia buco-maxilo-facial, com 4 especialistas no corpo clínico."
          }
        },
        {
          "@type": "Question",
          "name": "O hospital atende oftalmologia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. O atendimento oftalmológico é feito pelo Centro Goiano da Visão, dentro do Hospital Jacob Facuri. Mais informações em https://jacobfacuri.com.br/oftalmologia/."
          }
        },
        {
          "@type": "Question",
          "name": "As especialidades são atendidas por convênio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O hospital atende particulares e 18 operadoras, mediante confirmação de cobertura do plano. A lista completa está em https://jacobfacuri.com.br/convenios/."
          }
        }
      ]
